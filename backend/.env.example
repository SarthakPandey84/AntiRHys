# ==============================================================================
# AntiRHys Backend Environment Configuration (.env)
# ==============================================================================

# Environment mode: "production" or "development"
# In production, missing Origin headers and unauthorized cross-origin requests are rejected.
ENVIRONMENT=development

# Comma-separated list of allowed origins for WebSocket connections (CORS/CSWSH protection).
# In production on Render, set this to your official frontend domain(s):
# ALLOWED_ORIGINS=https://antirhys.vercel.app
# Leaving blank in development defaults to localhost (5173, 3000, 127.0.0.1, testserver).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum simultaneous active WebSocket client connections (protects server resources)
MAX_CONCURRENT_SESSIONS=10

# Thread-safe session telemetry log path (ephemeral on free-tier Render containers)
SESSION_LOG_PATH=session_log.csv

# Session authorization token (optional).
# SECURITY NOTICE: If configured, client connections must supply this token via
# ?token=... or Authorization: Bearer <token>. Note that frontend tokens placed in
# VITE_AUTH_TOKEN are bundled into public client JS and are visible to end users.
# Use this token to prevent unauthenticated bot spam, NOT as a secret server master key.
AUTH_TOKEN=
