# Backend Environment Variables
# In production, set to your Vercel URL (e.g. https://antirhys.vercel.app).
# Leaving blank defaults to localhost origins (5173, 3000, testserver).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum simultaneous active WebSocket client connections
MAX_CONCURRENT_SESSIONS=10

# File path for thread-safe session CSV log (ephemeral unless persistent disk is attached)
SESSION_LOG_PATH=session_log.csv

# Session authorization token (leave blank for local development, set for public deployments)
AUTH_TOKEN=
