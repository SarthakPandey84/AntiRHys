# ==============================================================================
# AntiRHys Frontend Environment Configuration (.env)
# ==============================================================================

# WebSocket Backend URL:
# For local development:
VITE_WS_URL=ws://localhost:8000/ws/detect

# For production on Vercel:
# If omitted, the client automatically defaults to the live Render backend service
# (wss://antirhys-backend.onrender.com/ws/detect) whenever hosted on non-localhost domains.
# Explicit override:
# VITE_WS_URL=wss://antirhys-backend.onrender.com/ws/detect

# ------------------------------------------------------------------------------
# SECURITY NOTICE REGARDING VITE_* CLIENT-SIDE ENVIRONMENT VARIABLES:
# ------------------------------------------------------------------------------
# All VITE_* environment variables are statically compiled and baked into the
# public JavaScript bundle by Vite at build time (dist/assets/index-*.js).
#
# NEVER store private secrets, database credentials, server private keys, or
# confidential third-party credentials in VITE_* variables.
#
# If VITE_AUTH_TOKEN is configured to match the backend AUTH_TOKEN, it functions as
# a public client access token to filter out non-browser scanners, NOT as a secret key.
# ------------------------------------------------------------------------------
VITE_AUTH_TOKEN=
